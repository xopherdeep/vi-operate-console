{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/public/*": ["public/*"],
      "@/common/*": ["./src/components/common/*"],
      "@/ui/*": ["./src/components/common/ui/*"],
      "@/patterns/*": ["./src/components/common/patterns/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/api/*": ["./src/lib/api/*"],
      "@/utils/*": ["./src/lib/utils/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.css",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
, ".storybook/stories/Input.stories.tsx", ".storybook/stories/Checkbox.stories.tsx", ".storybook/stories/Card.stories.tsx", ".storybook/stories/Button.stories.tsx"  ],
  "exclude": ["node_modules", "~/.config"]
}
